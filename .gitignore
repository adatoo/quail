# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.moved-aside
.swiftpm/

# Vendored binaries (fetched by `task vendor:llama` / `task vendor:uv`)
Vendor/llama.cpp/
Vendor/uv/

# Signing and secrets
*.p12
*.mobileprovision
*.provisionprofile
sparkle_private_key*
.env

# macOS
.DS_Store

# Release artefacts
dist/
*.dmg
*.zip

# Per-developer signing identity (see Config/LocalSigning.xcconfig)
Config/LocalSigning.local.xcconfig

# Written by vendor:llama: which tag Vendor/llama.cpp holds (lets the next run skip the download)
Vendor/.llama-staged
Vendor/.uv-staged
.task/
release-notes.md
